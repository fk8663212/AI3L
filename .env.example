# 本機設定請優先執行 npm run local:setup，自動產生密鑰與資料庫密碼
# 也可連既有 PostgreSQL / Neon（雲端連線請保留 sslmode=require）
DATABASE_URL=postgresql://ai3l:CHANGE_ME@127.0.0.1:5432/ai3l

# local：圖片與錄音存本機；vercel：沿用 Vercel Blob + Google Drive
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local/storage

# 至少 32 bytes 的隨機值；正式環境請分別產生，不要共用
AUTH_SECRET=replace-with-a-random-auth-secret
APP_ENCRYPTION_KEY=replace-with-a-random-encryption-master-key
ACCESS_CODE_PEPPER=replace-with-a-random-code-pepper
CRON_SECRET=replace-with-a-random-cron-secret

# 執行 npm run local:setup 自動建立；手動貼入 scrypt 雜湊時請將 $ 寫成 \$
ADMIN_PASSWORD_HASH=scrypt\$replace\$replace

# 以下僅 STORAGE_DRIVER=vercel 時需要；本機模式請留空
# Vercel Blob 建立並連接 Private store 後會自動注入；
# 新版 Vercel Production 也可能改用短效 OIDC，不必手動建立此值
BLOB_READ_WRITE_TOKEN=

# 正式站台 URL，不要加結尾斜線
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
